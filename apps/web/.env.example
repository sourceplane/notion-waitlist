# Notion: the integration (https://www.notion.so/profile/integrations) whose
# secret writes each signup, and the id of the database it writes to — the
# database shared with the integration, with a `Name` (title) and an `Email`
# (email) property. In a deployed environment they are the NOTION_SECRET and
# NOTION_DB Orun secrets (README → Connect Notion and Resend); never commit
# them.
NOTION_SECRET=
NOTION_DB=

# Resend: the API key that sends the welcome email, and the sender it sends
# from — an address on a domain verified in Resend, e.g.
# "Your Name <hello@waitlist.your-domain.com>". The RESEND_API_KEY and
# RESEND_FROM Orun secrets in a deployed environment.
RESEND_API_KEY=
RESEND_FROM=

# Optional. The site's public origin (the Open Graph image's absolute URL,
# the email's logo); the Orun build sets it to the environment's SITE_URL or
# Worker URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
