{
  "extends": "../../tooling/tsconfig/web.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "paths": {
      "app/*": [
        "../../apps/web/app/*"
      ],
      "lib/*": [
        "../../apps/web/lib/*"
      ],
      "emails": [
        "../../apps/web/emails/index.tsx"
      ]
    },
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
